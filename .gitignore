# --- Real configuration: addresses, user names, passwords, keys. NEVER commit. ---
# (the committed template is mustardos-remoteai.conf.example)
mustardos-remoteai.conf
*.conf.local

# --- Keys (the console key lives on the console; public keys go into mustardos-remoteai.conf) ---
id_ed25519
id_ed25519.pub
*.pub
*.key
*.pem
known_hosts

# --- Runtime files written by the scripts ---
laptop/.last_dir
laptop/.session_request
*.log
*.bak-remoteai
